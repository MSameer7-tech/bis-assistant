# =============================================================================
# Bureau of Indian Standards (BIS) AI Assistant - Environment Configuration
# Phase F2: Production RAG + Groq LLM Fallback
# =============================================================================

# Server Configuration (Railway sets PORT automatically)
HOST=0.0.0.0
PORT=8000

# CORS Configuration (Comma-separated list of allowed frontend origins)
# In production, set this to your Vercel deployment URL, e.g. https://your-app.vercel.app
FRONTEND_ORIGIN=http://localhost:3000,http://127.0.0.1:3000

# Groq API Configuration (Mandatory for live Groq LLM calls)
GROQ_API_KEY=gsk_your_groq_api_key_here

# Groq Model Identifier (Production Model: openai/gpt-oss-120b)
BIS_LLM_MODEL=openai/gpt-oss-120b

# Sampling Temperature (Strictly 0.0 for deterministic factual consistency)
BIS_LLM_TEMPERATURE=0.0

# Optional Custom Base URL (Default: https://api.groq.com/openai/v1)
# BIS_LLM_BASE_URL=https://api.groq.com/openai/v1

# Maximum Tokens
BIS_LLM_MAX_TOKENS=2048

# Request Timeout (seconds)
BIS_LLM_TIMEOUT=30.0

# Geoapify Geocoding API Configuration (Server-side only)
GEOAPIFY_API_KEY=

# =============================================================================
# Supabase Authentication Configuration
# =============================================================================
# Public Supabase Client URL (e.g. https://xyzcompany.supabase.co)
SUPABASE_URL=https://your-project.supabase.co

# Public Supabase Anon / Publishable Client Key
SUPABASE_ANON_KEY=your-anon-public-key-here

# Optional: Supabase JWT Secret for legacy HS256 verification (asymmetric JWKS is primary)
SUPABASE_JWT_SECRET=

